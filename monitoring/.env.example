# Copy to .env, fill in, chmod 600. Never committed (rule 30).
GF_SECURITY_ADMIN_PASSWORD=

# Brevo SMTP relay — alertmanager speaks SMTP natively, so no webhook
# receiver and no bespoke code in the alerting path (§14).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_API_KEY=
ALERT_SENDER=
# MUST NOT be an address only reachable through this server.
ALERT_RECIPIENT=
