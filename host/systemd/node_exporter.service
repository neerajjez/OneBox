# Managed from git — see host/README.md
#
# Runs on the HOST, not in a container. Containerising node_exporter means
# bind-mounting /proc, /sys and / — a container with near-host visibility that
# STILL misreports some host metrics. A systemd unit avoids both problems.
#
# Bind addresses: loopback for host-local checks, and the backend-net gateway
# so Prometheus (which is on that internal network) can scrape it. NEVER
# 0.0.0.0. backend-net's subnet is pinned to 172.19.0.0/24 precisely so this
# address is stable — see docs/context/DECISIONS.md D-012.

[Unit]
Description=Prometheus node_exporter
Documentation=https://github.com/prometheus/node_exporter
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter \
  --web.listen-address=127.0.0.1:9100 \
  --web.listen-address=172.19.0.1:9100 \
  --collector.textfile.directory=/var/lib/node_exporter/textfile_collector \
  --collector.systemd \
  --no-collector.wifi \
  --no-collector.infiniband \
  --no-collector.nfs \
  --no-collector.nfsd \
  --no-collector.zfs

Restart=on-failure
RestartSec=5s

# Hardening — node_exporter needs to read /proc and /sys, nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/node_exporter
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
