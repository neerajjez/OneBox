#===============================================================================
# OneBox — single configuration file
#===============================================================================
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# .env is gitignored. Never commit it. If a secret does reach git, ROTATE it —
# removing it in a later commit does nothing, because it stays in the object
# store and in every clone.
#
# Per-project .env files are generated from this one:
#
#   ./scripts/render-env.sh
#
# so there is exactly one place to edit and no chance of two files disagreeing.
#===============================================================================


#-------------------------------------------------------------------------------
# 1. IDENTITY — who and where
#-------------------------------------------------------------------------------

# Your domain. Everything is served from paths under it, not subdomains:
#   /            portfolio or landing page
#   /monitoring/ Grafana
#   /webrdp/     Kasm Workspaces
DOMAIN=yourdomain.com

# Short hostname of this server. Appears in every log line and alert.
HOSTNAME=onebox-prod

# Admin user created by bootstrap-ubuntu.sh. Owns the deployment.
ADMIN_USER=prodadmin

# Where persistent data lives. Point this at your LARGE disk, not the root
# volume. A full root disk takes down sshd and Docker together.
DATA_ROOT=/mnt/data

# Timezone for logs. Leave as UTC. Local time in logs costs an hour of
# confusion twice a year, at daylight-saving boundaries.
TZ=UTC


#-------------------------------------------------------------------------------
# 2. TLS — Let's Encrypt via DNS-01
#-------------------------------------------------------------------------------

# Email for Let's Encrypt expiry notices. Must be real and monitored.
ACME_EMAIL=you@example.com

# DNS-01 is used rather than HTTP-01, and that is a CONSTRAINT, not taste:
# once ingress is restricted to Cloudflare's IP ranges (section 4), Let's
# Encrypt's HTTP-01 validators are blocked and every renewal fails ~60 days
# later, with no obvious link to the firewall change that caused it.
# DNS-01 needs no inbound path and can issue wildcards.
#
# Cloudflare -> My Profile -> API Tokens -> Create Token
#   Permissions:    Zone / DNS  / Edit
#                   Zone / Zone / Read
#   Zone Resources: Include / Specific zone / <your domain>
# Use a SCOPED token. The Global API Key authenticates as your entire account,
# registrar included, and cannot be limited or revoked independently.
CLOUDFLARE_API_TOKEN=

# Issue a wildcard alongside the apex. Costs nothing and saves a reissue later.
ACME_WILDCARD=true


#-------------------------------------------------------------------------------
# 3. MONITORING
#-------------------------------------------------------------------------------

# Grafana admin password. Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Prometheus retention. 15d is deliberate on a 2-core box: it roughly halves
# the memory held for the head block versus 30d, and this host has to share
# with a desktop workspace.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=4GB


#-------------------------------------------------------------------------------
# 4. ALERT EMAIL (Brevo)
#-------------------------------------------------------------------------------
#
# Brevo has TWO different credentials and they are not interchangeable:
#   - an SMTP key  -> Alertmanager can send mail natively, no extra service
#   - a v3 API key -> requires the alert-bridge sidecar in this repo
# If you have an SMTP key, use it and set ALERT_USE_SMTP=true. It removes a
# moving part from the path that tells you the server is broken.

ALERT_USE_SMTP=false

# --- if ALERT_USE_SMTP=true ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=

# --- if ALERT_USE_SMTP=false (alert-bridge) ---
BREVO_API_KEY=

# From address. Must be a verified sender in Brevo or mail is silently dropped.
ALERT_SENDER=alerts@yourdomain.com

# Where alerts go. MUST NOT be an address that only works while this server is
# up — otherwise the outage notification depends on the thing that is down.
ALERT_RECIPIENT=you@example.com


#-------------------------------------------------------------------------------
# 5. BACKUPS
#-------------------------------------------------------------------------------

# Encrypts every archive. Generate: openssl rand -base64 24
#
# STORE THIS SOMEWHERE THAT IS NOT THIS SERVER. It protects backups OF this
# host; if the only copy lives here, a disk failure takes both the data and
# the means to read it. That is not a backup, it is encrypted noise.
BACKUP_PASSPHRASE=

# Local retention.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# --- off-site: any S3-compatible object store ---------------------------------
# Verified with Oracle Object Storage; also works with Backblaze B2, Wasabi,
# MinIO, or AWS S3.
OFFSITE_ENABLED=true
OFFSITE_BUCKET=your-backup-bucket
OFFSITE_ENDPOINT=https://YOUR-NAMESPACE.compat.objectstorage.your-region.oraclecloud.com
OFFSITE_REGION=your-region
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=

# Hard ceiling the backup script ENFORCES: it refuses to start if one archive
# would not fit, verifies the uploaded size by reading it back, then prunes
# oldest-first until usage is under this. Set below your free-tier limit —
# 9.90 GB against a 10 GB allowance leaves room for a bad day.
OFFSITE_BUDGET_BYTES=9900000000
OFFSITE_KEEP=30


#-------------------------------------------------------------------------------
# 6. REMOTE DESKTOP (Kasm Workspaces)
#-------------------------------------------------------------------------------

# Served at https://$DOMAIN/webrdp/ — a path, not a subdomain.
#
# proxy_path must be "<external-prefix>/desktop". Kasm's proxy hardcodes an
# internal /desktop/ location, so this value is BOTH the external prefix and
# its own internal path. Four values were tried before this one:
#   /webrdp        -> double slash in session URLs
#   webrdp         -> 404
#   desktop        -> 404 (resolved from root, hit the wrong site)
#   webrdp/desktop -> correct
KASM_ENABLED=true
KASM_PROXY_PATH=webrdp/desktop
KASM_ADMIN_PASSWORD=
KASM_USER_PASSWORD=
KASM_DB_PASSWORD=


#-------------------------------------------------------------------------------
# 7. NETWORK AND FIREWALL
#-------------------------------------------------------------------------------

# Tailscale IPv4 of this host: `tailscale ip -4`.
# Admin access (SSH, RDP) goes over the tailnet, never the public internet.
TAILSCALE_IP=100.64.0.10

# Put Cloudflare in front and restrict inbound 443 to its published ranges.
#
# Without this the origin is directly reachable and Cloudflare is trivially
# bypassed — its DDoS protection and WAF only apply to traffic that goes
# THROUGH it. Origin IPs leak constantly via old DNS records, certificate
# transparency logs, and scan databases.
CLOUDFLARE_PROXY=true

# Refresh with: ./scripts/cf-range-drift.sh
# Cloudflare changes these occasionally. A stale allowlist means some edges
# cannot reach you and SOME visitors get 522 — geography-dependent, and it will
# not reproduce from your own machine.
CF_RANGES_FILE=host/cloudflare/ips-v4.txt


#-------------------------------------------------------------------------------
# 8. RESOURCE LIMITS
#-------------------------------------------------------------------------------
#
# Tuned for 2 vCPU / 12 GB. Every container declares a CPU limit, a memory
# limit AND a memory reservation. Reservations are the load-bearing setting:
# they tell the kernel what to protect, so a desktop workspace is evicted
# before Prometheus is.

RES_PROMETHEUS_CPU=0.50
RES_PROMETHEUS_MEM=1024M
RES_PROMETHEUS_MEM_RESERVE=768M

RES_GRAFANA_CPU=0.40
RES_GRAFANA_MEM=512M
RES_GRAFANA_MEM_RESERVE=256M

RES_NGINX_CPU=0.30
RES_NGINX_MEM=192M

RES_KASM_WORKSPACE_CPU=1.0
RES_KASM_WORKSPACE_MEM=2048M
