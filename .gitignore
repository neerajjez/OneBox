# Secrets — never committed. If one gets in, ROTATE it; removing it in a later
# commit does nothing, it stays in the object store and in every clone.
.env
.env.*
!.env.example
.backup-env
*.key
*.pem
certs/
secrets/
**/certbot/

# Generated by scripts/render-env.sh
monitoring/.env
proxy-nginx/.env
alert-bridge/.env

# Runtime state
logs/
*.log
backups/
data/

# Local tooling
graphify-out/
.DS_Store
